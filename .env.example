# ---------------------------------------------------------------
# 7DCONSTRUCTION — environment variables
# Copy this file to ".env.local" and fill in only what you need.
# The site runs without any of these values.
# NEVER put a Supabase "service_role" key in any NEXT_PUBLIC_* variable.
# ---------------------------------------------------------------

# Verified owner contact details (leave empty until confirmed).
# WhatsApp number: international format, digits only (e.g. 216XXXXXXXX).
# An 8-digit Tunisian number is automatically prefixed with 216.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# Estimator mode:
#   demo      -> numeric estimate shown with a clear "demonstration rates" notice (default)
#   verified  -> use after you replaced the demo rates in components/estimator/estimatorConfig.js
#   disabled  -> no numbers shown; scope summary + contact only
NEXT_PUBLIC_ESTIMATOR_MODE=demo

# Optional: persistent inquiry storage with Supabase.
# Use the project URL and the public "anon" key ONLY (see README for the SQL + RLS policy).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
